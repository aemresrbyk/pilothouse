{
  "name": "pilothouse-server",
  "version": "1.12.1",
  "description": "Pilothouse without the window: run coding agents on a server, answer them from usepilothouse.com/app or the iPhone app.",
  "license": "MIT",
  "homepage": "https://usepilothouse.com",
  "repository": "github:aemresrbyk/pilothouse",
  "type": "module",
  "bin": {
    "pilothouse-server": "dist/pilothouse-server.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'),p=require('path'),d='node_modules/node-pty/prebuilds';if(process.platform!=='win32'&&fs.existsSync(d))for(const x of fs.readdirSync(d)){const f=p.join(d,x,'spawn-helper');if(fs.existsSync(f))fs.chmodSync(f,0o755)}\""
  }
}
