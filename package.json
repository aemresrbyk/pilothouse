{
  "name": "pilothouse",
  "version": "1.2.0",
  "description": "Pilothouse: a desktop cockpit with tabbed embedded terminals for Claude Code",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "pack": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path'),d='node_modules/node-pty/prebuilds';if(process.platform!=='win32'&&fs.existsSync(d))for(const x of fs.readdirSync(d)){const f=p.join(d,x,'spawn-helper');if(fs.existsSync(f))fs.chmodSync(f,0o755)}\"",
    "typecheck": "tsc --noEmit",
    "build:whisper": "bash scripts/build-whisper.sh"
  },
  "build": {
    "appId": "com.aemresrbyk.pilothouse",
    "productName": "Pilothouse",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "aemresrbyk",
      "repo": "pilothouse"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Pilothouse-${arch}-mac.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "Pilothouse opens terminals and reads git status for projects stored in your Desktop folder.",
        "NSDocumentsFolderUsageDescription": "Pilothouse opens terminals and reads git status for projects stored in your Documents folder.",
        "NSDownloadsFolderUsageDescription": "Pilothouse opens terminals and reads git status for projects stored in your Downloads folder.",
        "NSMicrophoneUsageDescription": "Pilothouse listens only while you speak a prompt (hotkey or mic button). Speech is recognised on this Mac and never uploaded."
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "vendor/whisper/whisper-cli",
        "to": "whisper-cli"
      },
      {
        "from": "resources/wakeword",
        "to": "wakeword"
      },
      {
        "from": "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm",
        "to": "wakeword/ort-wasm-simd-threaded.wasm"
      },
      {
        "from": "resources/tray",
        "to": "tray"
      }
    ]
  },
  "keywords": [
    "claude",
    "claude-code",
    "launcher",
    "desktop",
    "anthropic",
    "electron"
  ],
  "author": "Ali Emre Sarıbıyık (aemresrbyk) <https://github.com/aemresrbyk>",
  "repository": {
    "type": "git",
    "url": "https://github.com/aemresrbyk/pilothouse.git"
  },
  "bugs": {
    "url": "https://github.com/aemresrbyk/pilothouse/issues"
  },
  "homepage": "https://github.com/aemresrbyk/pilothouse#readme",
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.65.0",
    "node-pty": "^1.1.0",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
