          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에서 Pilothouse 열기"
          }
        }
      }
    },
    "Settings → Remote control": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar → Uzaktan kontrol"
          }
        },
        "es": {
