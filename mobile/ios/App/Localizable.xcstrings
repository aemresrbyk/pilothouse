    "If it is still running in another terminal, close it there first, or both will write to the same conversation.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir terminalde hâlâ çalışıyorsa önce orada kapat; yoksa ikisi de aynı konuşmaya yazar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sigue abierta en otro terminal, ciérrala allí primero o ambas escribirán en la misma conversación."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ainda estiver rodando em outro terminal, feche lá primeiro, senão os dois vão escrever na mesma conversa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft sie noch in einem anderen Terminal, schließe sie dort zuerst, sonst schreiben beide in dieselbe Unterhaltung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si elle tourne encore dans un autre terminal, fermez-la d’abord, sinon les deux écriront dans la même conversation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если он ещё запущен в другом терминале, сначала закройте его там, иначе оба будут писать в один разговор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果它仍在另一个终端中运行，请先在那里关闭，否则两边会写入同一个对话。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のターミナルでまだ動いている場合は先にそちらを閉じてください。両方が同じ会話に書き込んでしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 터미널에서 아직 실행 중이면 먼저 거기서 닫으세요. 그렇지 않으면 둘 다 같은 대화에 씁니다."
          }
        }
      }
    },
