    "No computer at hand? Try a demo": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanında bilgisayar yok mu? Demoyu dene"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sin ordenador a mano? Prueba la demo"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem computador por perto? Experimente a demo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Computer zur Hand? Probier die Demo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’ordinateur sous la main ? Essayez la démo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет компьютера рядом? Попробуйте демо"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手边没有电脑？试试演示"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータがない？デモを試す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터가 없나요? 데모 체험"
          }
        }
      }
    },
    "Open Pilothouse on your computer": {
      "localizations": {
        "tr": {
