{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "Security code": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik kodu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de seguridad"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de segurança"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherheitscode"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code de sécurité"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код безопасности"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全码"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティコード"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 코드"
          }
        }
      }
    },
    "Your computer shows a code too. Click Allow there if they match.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarında da bir kod görünüyor. Eşleşiyorsa orada Allow’a bas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ordenador también muestra un código. Pulsa Allow allí si coinciden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu computador também mostra um código. Clique em Allow lá se forem iguais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Computer zeigt auch einen Code. Klicke dort auf Allow, wenn sie übereinstimmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ordinateur affiche aussi un code. Cliquez sur Allow s’ils sont identiques."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютер тоже показывает код. Если коды совпадают, нажмите там Allow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑上也会显示一个码。如果一致，请在电脑上点 Allow。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータにもコードが表示されます。一致したらそちらで Allow を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에도 코드가 표시됩니다. 같으면 컴퓨터에서 Allow를 누르세요."
          }
        }
      }
    },
    "Scan QR code": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "QR kodu okut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanear código QR"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanear QR code"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-Code scannen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanner le QR code"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканировать QR-код"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描二维码"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QR コードを読み取る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 코드 스캔"
          }
        }
      }
    },
    "Opens the camera to scan the QR code shown in Pilothouse on your computer": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarındaki Pilothouse’ta görünen QR kodu okutmak için kamerayı açar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la cámara para escanear el código QR que muestra Pilothouse en tu ordenador"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a câmera para escanear o QR code exibido no Pilothouse do seu computador"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Kamera, um den QR-Code aus Pilothouse auf deinem Computer zu scannen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l’appareil photo pour scanner le QR code affiché par Pilothouse sur votre ordinateur"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает камеру, чтобы отсканировать QR-код из Pilothouse на компьютере"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开相机，扫描电脑上 Pilothouse 显示的二维码"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータの Pilothouse に表示された QR コードをカメラで読み取ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터의 Pilothouse에 표시된 QR 코드를 카메라로 스캔합니다"
          }
        }
      }
    },
    "This iPhone can't scan codes here. Paste the link instead.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone burada kod okutamıyor. Bunun yerine linki yapıştır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone no puede escanear códigos aquí. Pega el enlace."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone não consegue escanear códigos aqui. Cole o link."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone kann hier keine Codes scannen. Füge stattdessen den Link ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone ne peut pas scanner de code ici. Collez plutôt le lien."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот iPhone не может сканировать коды здесь. Вставьте ссылку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 无法在此扫描。请改为粘贴链接。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone ではここでコードを読み取れません。リンクを貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서는 여기서 코드를 스캔할 수 없습니다. 대신 링크를 붙여 넣으세요."
          }
        }
      }
    },
    "Paste the link": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Linki yapıştır"
