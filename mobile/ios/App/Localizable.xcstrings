    "Swipe left to unpair one. All their agents show up in one list.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşmeyi kaldırmak için sola kaydır. Tüm ajanları tek listede görünür."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la izquierda para desemparejar. Todos sus agentes aparecen en una lista."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para a esquerda para desparear. Todos os agentes aparecem em uma lista."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach links wischen zum Entkoppeln. Alle Agenten erscheinen in einer Liste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez vers la gauche pour dissocier. Tous leurs agents apparaissent dans une seule liste."
