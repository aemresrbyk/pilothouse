    "Risky command: deletes, force-pushes, deploys, sudo or secrets. Check it before approving.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Riskli komut: silme, force-push, yayına alma, sudo ya da gizli bilgiler. Onaylamadan önce kontrol et."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comando arriesgado: borra, hace force-push, despliega, usa sudo o secretos. Revísalo antes de aprobar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comando arriscado: apaga, faz force-push, faz deploy, usa sudo ou segredos. Confira antes de aprovar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Riskanter Befehl: Löschen, Force-Push, Deploy, sudo oder Geheimnisse. Prüfe ihn vor der Freigabe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commande risquée : suppression, force-push, déploiement, sudo ou secrets. Vérifiez avant d’accepter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опасная команда: удаление, force-push, деплой, sudo или секреты. Проверьте перед одобрением."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高风险命令：删除、强制推送、部署、sudo 或机密。批准前请检查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "危険なコマンド：削除、強制プッシュ、デプロイ、sudo、シークレット。承認前に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위험한 명령: 삭제, 강제 푸시, 배포, sudo 또는 비밀 정보. 승인 전에 확인하세요."
          }
        }
      }
    },
