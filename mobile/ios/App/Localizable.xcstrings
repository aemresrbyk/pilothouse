    "No agent tabs open. Open one from Projects below.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık ajan sekmesi yok. Aşağıdaki Projeler’den birini aç."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay pestañas de agentes abiertas. Abre una desde Proyectos, abajo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma aba de agente aberta. Abra uma em Projetos, abaixo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Agenten-Tabs offen. Öffne einen unten bei Projekte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun onglet d’agent ouvert. Ouvrez-en un depuis Projets ci-dessous."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет открытых вкладок агентов. Откройте одну в разделе «Проекты» ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有打开的智能体标签页。从下方的项目中打开一个。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントのタブはありません。下のプロジェクトから開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열린 에이전트 탭이 없습니다. 아래 프로젝트에서 여세요."
          }
        }
      }
    },
