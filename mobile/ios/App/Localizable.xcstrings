        }
      }
    },
    "Scan it, then click Allow there": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okut, sonra orada Allow’a bas"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanéalo y pulsa Allow allí"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie e clique em Allow lá"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen, dann dort Allow klicken"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez-le, puis cliquez sur Allow"
          }
        },
        "ru": {
